<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Product Attribute -->
        <record id="product_attribute_portion" model="product.attribute">
            <field name="name">Portion</field>
            <field name="display_type">pills</field>
            <field name="create_variant">no_variant</field>
        </record>

        <!-- Product Attribute Values -->
        <record id="product_attribute_value_single" model="product.attribute.value">
            <field name="name">Single</field>
            <field name="attribute_id" ref="pos_grand_gupshup.product_attribute_portion"/>
            <field name="sequence">1</field>
        </record>
        <record id="product_attribute_value_half" model="product.attribute.value">
            <field name="name">Half</field>
            <field name="attribute_id" ref="pos_grand_gupshup.product_attribute_portion"/>
            <field name="sequence">2</field>
        </record>
        <record id="product_attribute_value_full" model="product.attribute.value">
            <field name="name">Full</field>
            <field name="attribute_id" ref="pos_grand_gupshup.product_attribute_portion"/>
            <field name="sequence">3</field>
        </record>
    </data>
</odoo>
